{
  "name": "pi-feishu-link",
  "version": "0.1.1",
  "description": "High-reliability Feishu/Lark bridge for Pi — zero-config onboarding, persistent outbox (at-least-once), connection watchdog, permission bridge, diagnostics (npm 发布名：pi-feishu-link，npm 上 pi-feishu-link 已被他人占用)",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "feishu",
    "lark",
    "bridge",
    "bot"
  ],
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.72.0",
    "qrcode-terminal": "^0.12.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^5.9.2"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --import ./test/register.mjs --test \"test/**/*.test.ts\""
  }
}
